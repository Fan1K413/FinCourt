# Variable names belong to FinCourt.
FINCOURT_MODE=fixture
# Leave empty for the local SQLite fixture. Example for Docker Compose:
# FINCOURT_DATABASE_URL=postgresql+psycopg://fincourt:<local-password>@127.0.0.1:55432/fincourt
FINCOURT_DATABASE_URL=
FINCOURT_STORAGE_DIR=./var/storage
FINCOURT_NEXENT_BASE_URL=
FINCOURT_NEXENT_API_TOKEN=
FINCOURT_NEXENT_AGENT_NAME=
FINCOURT_NEXENT_RELEASE=
FINCOURT_MCP_SECRET=
FINCOURT_ADMIN_TOKEN=
